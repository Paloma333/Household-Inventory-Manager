# --- Supabase (Sprint 0 必需) ---
# 在 https://supabase.com/dashboard 创建项目后，从 Project Settings → API 复制
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Service role key 仅在服务端 route 用，绝不要 commit 或暴露给前端
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# --- AI 视觉（可选；不填则 AI 识别走 mock 假数据） ---
# 阿里百炼 DashScope：https://bailian.console.aliyun.com/ 申请 API-KEY
# 模型用 qwen-vl-plus（识别小票/截图/拍照）。代码同时兼容 QWEN_API_KEY 旧名。
DASHSCOPE_API_KEY=
# 备 GLM-4V：https://open.bigmodel.cn/
GLM_API_KEY=
# 强制走 mock（调试用，不填则自动判断）
# MOCK_AI=1

# --- 应用配置 ---
# 部署前改成真实域名：https://your-project.vercel.app（影响 OG、Twitter Card、sitemap）
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=小家
